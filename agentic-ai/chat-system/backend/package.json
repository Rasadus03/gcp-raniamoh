{
  "name": "chat-system-microservices-backend",
  "version": "1.0.0",
  "description": "Real-Time Multi-User Chat System Microservices Backend (Cloud Spanner + Cloud Firestore + Cloud Pub/Sub + WebSockets)",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/src/public && cp -r src/public/* dist/src/public/",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "node dist/scripts/seed.js",
    "test:unit": "npm run build && node --test dist/tests/backend.unit.test.js",
    "test:e2e": "node dist/scripts/test-e2e.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/pubsub": "^4.9.0",
    "@google-cloud/spanner": "^7.15.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
